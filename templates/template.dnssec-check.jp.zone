success.ed25519			IN	NS	ns.success.ed25519.dnssec-check.jp.
keytag.ds.error.ed25519		IN	NS	ns.keytag.ds.error.ed25519.dnssec-check.jp.
hash.ds.error.ed25519		IN	NS	ns.hash.ds.error.ed25519.dnssec-check.jp.
sign.ds.error.ed25519		IN	NS	ns.sign.ds.error.ed25519.dnssec-check.jp.
sign.dnskey.error.ed25519	IN	NS	ns.sign.dnskey.error.ed25519.dnssec-check.jp.
expire.dnskey.error.ed25519	IN	NS	ns.expire.dnskey.error.ed25519.dnssec-check.jp.
sign.a.error.ed25519		IN	NS	ns.sign.a.error.ed25519.dnssec-check.jp.
