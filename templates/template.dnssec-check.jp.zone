sign.ds.error.ecdsap256sha256		IN	NS	ns.sign.ds.error.ecdsap256sha256.dnssec-check.jp.
sign.dnskey.error.ecdsap256sha256	IN	NS	ns.sign.dnskey.error.ecdsap256sha256.dnssec-check.jp.
expire.dnskey.error.ecdsap256sha256	IN	NS	ns.expire.dnskey.error.ecdsap256sha256.dnssec-check.jp.
sign.a.error.ecdsap256sha256		IN	NS	ns.sign.a.error.ecdsap256sha256.dnssec-check.jp.
