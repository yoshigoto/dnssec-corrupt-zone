expire.dnskey.error.ed448	IN	NS	ns.expire.dnskey.error.ed448.dnssec-check.jp.
sign.a.error.ed448		IN	NS	ns.sign.a.error.ed448.dnssec-check.jp.
;
cover.mismatch.nsec.rsasha256	IN	NS	ns.cover.mismatch.nsec.rsasha256.dnssec-check.jp.
type.mismatch.nsec.rsasha256	IN	NS	ns.type.mismatch.nsec.rsasha256.dnssec-check.jp.
